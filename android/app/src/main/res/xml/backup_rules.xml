<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup en Android 11 o anterior (en 12+ manda data_extraction_rules.xml).
     Se respalda todo (equipos/partidos en Hive incluidos) salvo la sesión de
     Firebase Auth: está cifrada con una clave del Android Keystore, que nunca
     se respalda, así que restaurarla sin esa clave rompe el guardado de la
     sesión en cada login (ver MainActivity.resetOrphanedFirebaseAuthKeyset).
     El sufijo es FirebaseApp.getPersistenceKey() de la app [DEFAULT]: base64
     de "[DEFAULT]" + "+" + base64 del appId de Android en google-services.json
     (1:1082356934892:android:fdcf1c7d5871a765299dc9); si cambia el proyecto de
     Firebase o el appId, hay que actualizarlo acá y en data_extraction_rules.xml.
     También se excluye rallystats_backups/: la copia previa de los datos que
     hace la app al pasar a datos por cuenta (StorageService). Cuenta contra el
     tope de 25 MB del respaldo en la nube y, si se pasa, Android deja de
     respaldar todo (Hive incluido). Hive (y por lo tanto los cajones de cada
     cuenta) vive en app_flutter/, que es lo que devuelve
     getApplicationDocumentsDirectory() en Android: el dominio "root" es el
     directorio de datos de la app, padre de app_flutter/. En Android 11 o
     anterior no hay forma de excluirla solo de la nube (este archivo vale
     también para la transferencia entre equipos). -->
<full-backup-content>
    <exclude domain="sharedpref" path="com.google.firebase.auth.api.crypto.W0RFRkFVTFRd+MToxMDgyMzU2OTM0ODkyOmFuZHJvaWQ6ZmRjZjFjN2Q1ODcxYTc2NTI5OWRjOQ.xml" />
    <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.W0RFRkFVTFRd+MToxMDgyMzU2OTM0ODkyOmFuZHJvaWQ6ZmRjZjFjN2Q1ODcxYTc2NTI5OWRjOQ.xml" />
    <exclude domain="root" path="app_flutter/rallystats_backups/" />
</full-backup-content>
